{
  "name": "@sero-ai/plugin-user-feedback",
  "version": "0.1.0",
  "description": "User feedback tools for Sero - question and questionnaire",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "pnpm exec vitest run --root .",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p extension/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "sero": {
    "app": {
      "id": "userfeedback",
      "styleIsolation": "scope",
      "name": "User Feedback",
      "icon": "message-circle-question",
      "stateFile": ".sero/apps/userfeedback/state.json",
      "ui": "./dist/ui/remoteEntry.js",
      "component": "UserFeedbackApp",
      "devPort": 5182
    },
    "plugin": {
      "category": "utilities",
      "tags": [
        "questions",
        "questionnaire",
        "feedback"
      ],
      "minSeroVersion": "0.1.0",
      "runtimeAbi": 2,
      "preBuilt": false,
      "bridgeTools": false
    }
  },
  "dependencies": {
    "@sero-ai/common": "workspace:*",
    "typebox": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:peer",
    "@earendil-works/pi-tui": "catalog:peer",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@sero-ai/plugin-vite": "workspace:*",
    "@module-federation/vite": "catalog:",
    "@sero-ai/app-runtime": "workspace:@sero-ai/app-runtime@*",
    "@sero-ai/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
