{
  "name": "@sero-ai/plugin-web",
  "version": "0.1.0",
  "description": "Web search, content fetching, and video understanding for Sero",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "pnpm exec vitest run --root .",
    "package-runtime": "npm install --package-lock-only --ignore-scripts --omit=dev && npm install --ignore-scripts --omit=dev",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p extension/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "sero": {
    "app": {
      "id": "web",
      "name": "Web",
      "icon": "globe",
      "stateFile": ".sero/apps/web/state.json",
      "ui": "./dist/ui/remoteEntry.js",
      "component": "WebApp",
      "devPort": 5195,
      "widgets": [
        {
          "id": "activity",
          "name": "Web Activity",
          "component": "WebWidget",
          "description": "Recent web searches and fetches",
          "defaultSize": {
            "w": 2,
            "h": 2
          },
          "minSize": {
            "w": 2,
            "h": 2
          },
          "maxSize": {
            "w": 4,
            "h": 3
          }
        }
      ]
    },
    "plugin": {
      "category": "productivity",
      "tags": [
        "web",
        "search",
        "fetch",
        "youtube",
        "github"
      ],
      "minSeroVersion": "0.1.0",
      "preBuilt": false
    }
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@sinclair/typebox": "catalog:",
    "better-sqlite3": "^12.8.0",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.4.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "catalog:peer",
    "@mariozechner/pi-coding-agent": "catalog:peer",
    "@mariozechner/pi-tui": "catalog:peer",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@module-federation/vite": "catalog:",
    "@sero-ai/app-runtime": "workspace:@sero-ai/app-runtime@*",
    "@sero-ai/common": "workspace:*",
    "@sero-ai/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
