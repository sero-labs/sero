{
  "name": "@sero-ai/plugin-memory",
  "version": "0.1.0",
  "description": "Persistent memory for Sero chat sessions — identity, user profile, and curated memories",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest",
    "test:qmd": "node scripts/test-qmd.mjs",
    "typecheck": "tsc --noEmit -p extension/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "dependencies": {
    "@tobilu/qmd": "^2.5.3",
    "date-fns": "^4.4.0",
    "typebox": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "catalog:peer",
    "@earendil-works/pi-ai": "catalog:peer",
    "@earendil-works/pi-coding-agent": "catalog:peer",
    "@earendil-works/pi-tui": "catalog:peer",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@sero-ai/common": "workspace:*",
    "@sero-ai/extension-runtime": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sero": {
    "plugin": {
      "category": "utilities",
      "tags": [
        "memory",
        "identity",
        "profile"
      ],
      "minSeroVersion": "0.1.0",
      "bundleExtensions": true,
      "extensionExternals": [
        "@tobilu/qmd"
      ],
      "preBuilt": false
    }
  }
}
