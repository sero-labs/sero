{
  "name": "@sero-ai/plugin-memory",
  "version": "0.1.0",
  "description": "Persistent memory system for Sero \u2014 long-term facts, identity, user profile, and daily logs",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p extension/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:",
    "@tobilu/qmd": "^2.0.1"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "catalog:peer",
    "@mariozechner/pi-coding-agent": "catalog:peer",
    "@mariozechner/pi-tui": "catalog:peer",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "sero": {
    "plugin": {
      "category": "utilities",
      "tags": [
        "memory",
        "identity",
        "logs"
      ],
      "minSeroVersion": "0.1.0",
      "preBuilt": false
    }
  }
}
