{
  "name": "@sero-ai/plugin-graphify",
  "version": "0.1.0",
  "description": "Profile-wide knowledge graphs via Graphify — index every workspace, search across all of them",
  "type": "module",
  "keywords": ["pi-package"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "pnpm exec vitest run --root .",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p extension/tsconfig.json && tsc --noEmit -p runtime/tsconfig.json"
  },
  "pi": {
    "extensions": ["./extension/index.ts"]
  },
  "sero": {
    "app": {
      "id": "graphify",
      "styleIsolation": "scope",
      "portableState": ["settings"],
      "name": "Graphify",
      "icon": "waypoints",
      "scope": "global",
      "stateFile": ".sero/apps/graphify/state.json",
      "ui": "./dist/ui/remoteEntry.js",
      "component": "GraphifyApp",
      "contributes": {
        "components": [
          {
            "id": "global-search",
            "extensionPoint": "ui.global-search.panel",
            "component": "GraphifySearch",
            "description": "Search the profile-wide knowledge graph"
          }
        ],
        "controls": [
          {
            "id": "workspace-indexing",
            "extensionPoint": "workspace.create.option",
            "control": {
              "type": "switch",
              "label": "Enable Graphify indexing",
              "defaultValue": false
            },
            "action": {
              "type": "tool",
              "tool": "graphify_index",
              "params": { "action": "enable" }
            }
          }
        ]
      },
      "devPort": 5197,
      "runtime": "./runtime/index.ts"
    },
    "plugin": {
      "category": "developer-tools",
      "tags": ["knowledge-graph", "search", "context", "graphify"],
      "minSeroVersion": "0.1.0",
      "runtimeAbi": 2,
      "preBuilt": false,
      "requiredHostCapabilities": ["appAgent.invokeTool", "tool.cli", "appRuntime.background"]
    }
  },
  "dependencies": {
    "typebox": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "catalog:peer",
    "@earendil-works/pi-coding-agent": "catalog:peer",
    "@earendil-works/pi-tui": "catalog:peer",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@sero-ai/plugin-vite": "workspace:*",
    "@module-federation/vite": "catalog:",
    "@sero-ai/app-runtime": "workspace:@sero-ai/app-runtime@*",
    "@sero-ai/common": "workspace:*",
    "@sero-ai/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
