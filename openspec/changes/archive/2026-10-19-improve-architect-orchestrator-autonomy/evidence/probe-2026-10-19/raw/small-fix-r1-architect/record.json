  "milestones": [
    {
      "id": "m1",
      "title": "Fix truncate length bug and record example.com heading",
      "status": "done",
      "plan": "In src/text.js, change truncate so the returned string is at most max characters. When truncation happens and max >= 3, slice to max - 3 and append '...'. For max < 3 return a dot-only string of length max so the length bound still holds. Leave capitalize and the existing tests alone. Add tests covering truncation at max 4, 10, exact length, and max < 3, and run npm test. Then launch Sero browser automation, navigate to https://example.com, read the main heading, write it to NOTES.md, and close the browser. Provide a small static index.html preview route showing the recorded heading so the preview smoke check has a rendered page.",
      "preview": {
        "route": "/"
      },
