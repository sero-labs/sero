{
  "name": "sero",
  "version": "0.1.0",
  "description": "Zero context switch, zero sprawl — an agent-first workspace for macOS",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && NODE_ENV=development electron .",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:electron && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mariozechner/pi-coding-agent": "^0.52.7",
    "@monaco-editor/react": "^4.7.0",
    "@sinclair/typebox": "^0.34.48",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-core": "^4.13.1",
    "dockview-react": "^4.13.1",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.19.9",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "app.sero",
    "productName": "Sero",
    "mac": {
      "target": "dmg",
      "arch": [
        "arm64"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
