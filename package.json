{
  "name": "sero",
  "version": "0.1.0",
  "description": "Zero context switch, zero sprawl — an agent-first workspace for macOS",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && NODE_ENV=development electron .",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:electron && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest",
    "container:nat": "sudo ./scripts/setup-container-nat.sh",
    "container:nat:teardown": "sudo ./scripts/setup-container-nat.sh --teardown",
    "container:build-image": "cd images && container build -t sero-node:latest -f Dockerfile.sero-node ."
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headless-tree/core": "^1.6.3",
    "@headless-tree/react": "^1.6.3",
    "@hookform/resolvers": "^5.2.2",
    "@mariozechner/pi-agent-core": "^0.52.7",
    "@mariozechner/pi-ai": "^0.52.7",
    "@mariozechner/pi-coding-agent": "^0.52.7",
    "@mariozechner/pi-tui": "^0.52.7",
    "@module-federation/enhanced": "^2.0.0",
    "@module-federation/vite": "^1.11.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@remixicon/react": "^4.9.0",
    "@rive-app/react-webgl2": "^4.26.2",
    "@sinclair/typebox": "^0.34.48",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.0.2",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.0",
    "ai": "^6.0.79",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dockview-core": "^4.13.1",
    "dockview-react": "^4.13.1",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "media-chrome": "^4.17.2",
    "monaco-editor": "^0.52.2",
    "motion": "^12.34.0",
    "nanoid": "^5.1.6",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-jsx-parser": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.2",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.3",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.19.9",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.3",
    "shadcn": "^3.8.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "app.sero",
    "productName": "Sero",
    "mac": {
      "target": "dmg",
      "arch": [
        "arm64"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
