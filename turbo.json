{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "typecheck:source": {
      "dependsOn": ["^build"]
    },
    "typecheck:tests": {
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": []
    },
    "test:packaging": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "eval": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
