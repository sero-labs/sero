{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@sero/desktop#build": {
      "dependsOn": [
        "^build",
        "@sero-ai/plugin-admin#build",
        "@sero-ai/plugin-cron#build",
        "@sero-ai/plugin-design-library#build",
        "@sero-ai/plugin-git#build",
        "@sero-ai/plugin-graphify#build",
        "@sero-ai/plugin-mcp#build",
        "@sero-ai/plugin-orchestrator#build",
        "@sero-ai/plugin-usage#build",
        "@sero-ai/plugin-user-feedback#build",
        "@sero-ai/plugin-web#build"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "typecheck:source": {
      "dependsOn": ["^build"]
    },
    "typecheck:tests": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:packaging": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "eval": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
