---
import SectionHead from "./SectionHead.astro";
import { site } from "../content/copy";

const receipt = `$ sero --version
sero/0.x  pi-coding-agent  electron  react-19
source alpha  macOS/Linux/Windows  local runtimes`;
---
<section class="section" id="alpha">
	<SectionHead idx="06" label="honest_alpha" />
	<div class="cols">
		<h2 class="h2">early, useful, built in public.</h2>
		<div>
			<p class="prose">
				{site.description} Source-only OSS alpha; runtime and plugin contracts will evolve.
			</p>
			<pre class="receipt">{receipt}</pre>
		</div>
	</div>
</section>
