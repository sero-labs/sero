---
import SectionHead from "./SectionHead.astro";
import { site } from "../content/copy";

const receipt = `$ sero --version
sero/1.0  pi-coding-agent  electron  react-19
macOS/Linux/Windows  local runtimes`;
---
<section class="section" id="release">
	<SectionHead idx="06" label="honest_release" />
	<div class="cols">
		<h2 class="h2">early, useful, built in public.</h2>
		<div>
			<p class="prose">
				{site.description} Packaged installers for macOS, Linux and Windows; plugin and runtime contracts are still evolving.
			</p>
			<pre class="receipt">{receipt}</pre>
		</div>
	</div>
</section>
