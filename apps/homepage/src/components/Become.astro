---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { become, becomeNote } from "../content/copy";
---
<section class="section" id="become">
	<SectionHead idx="03" label="what_can_it_become" />
	<h2 class="h2">build the agent you actually want.</h2>

	<div class="pick">
		<div class="pick__grid">
			{become.map((b, i) => (
				<article class="pick__card">
					<div class="pick__head">
						<span class="pick__idx">--{b.id}</span>
						<span class="pick__name">{b.title}</span>
					</div>
					<figure>
						<Image
							src={b.image}
							widths={[480, 720, 960]}
							sizes="(max-width: 820px) 100vw, 50vw"
							format="webp"
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<p class="pick__tag">{b.tagline}</p>
					<ul class="pick__defaults">
						{b.defaults.map((d) => <li>+ {d}</li>)}
					</ul>
					<div class="pick__quoteWrap">
						<span class="pick__quoteLabel">example ask</span>
						<div class="pick__quote">
							<span class="shell-user">{">"}</span> {b.mineExample}
						</div>
					</div>
					<span class="pick__corner" aria-hidden="true">0{i + 1}</span>
				</article>
			))}
		</div>
	</div>
</section>
