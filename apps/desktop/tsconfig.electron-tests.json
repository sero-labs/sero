{
  "extends": "./tsconfig.electron.json",
  "compilerOptions": {
    "noEmit": true,
    // The response-parity tests drive renderer store reducers directly, so
    // this test program compiles renderer DOM code too.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "electron/**/*.d.ts",
    "electron/__tests__/**/*",
    "electron/preload/platform/user-feedback.ts",
    "src/**/*.d.ts",
    "src/types/ipc.ts",
    "src/types/ipc-channels.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
