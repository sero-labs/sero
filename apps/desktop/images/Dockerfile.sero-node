FROM ubuntu:24.04

ARG SERO_NODE_VERSION=dev
ARG NODE_MAJOR=24
LABEL org.opencontainers.image.title="Sero Node Runtime" \
      org.opencontainers.image.version="$SERO_NODE_VERSION"

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Base runtime, native build tools, and the official GitHub CLI apt repository.
RUN apt-get update -qq && \
    apt-get upgrade -y -qq && \
    apt-get install -y -qq --no-install-recommends \
      ca-certificates curl wget gpg xz-utils \
      tini \
      git openssh-client \
      procps less jq \
      iproute2 \
      build-essential \
      python3 python3-venv python3-pip \
      ripgrep fd-find unzip zip sqlite3 && \
    mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
      gpg --dearmor -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends gh && \
    ln -sf /usr/bin/fdfind /usr/local/bin/fd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install the current official Node.js 24 Linux tarball and verify its checksum.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      arm64) node_arch="arm64" ;; \
      amd64) node_arch="x64" ;; \
      *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    node_version="$(curl -fsSL https://nodejs.org/dist/index.json | python3 -c 'import json,sys,os; major="v"+os.environ.get("NODE_MAJOR", "24"); print(next(item["version"] for item in json.load(sys.stdin) if item["version"].startswith(major+".")))')"; \
    curl -fsSLO "https://nodejs.org/dist/${node_version}/node-${node_version}-linux-${node_arch}.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/${node_version}/SHASUMS256.txt"; \
    grep " node-${node_version}-linux-${node_arch}.tar.xz$" SHASUMS256.txt | sha256sum -c -; \
    tar -xJf "node-${node_version}-linux-${node_arch}.tar.xz" -C /usr/local --strip-components=1 --no-same-owner; \
    rm "node-${node_version}-linux-${node_arch}.tar.xz" SHASUMS256.txt; \
    node --version; \
    npm --version

# Pin the package manager declared by the monorepo.
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate

# Configure Git defaults for non-interactive agent use.
RUN git config --global user.name "Sero" && \
    git config --global user.email "sero@local" && \
    git config --global init.defaultBranch main

# agent-browser + Chromium/ffmpeg browser assets. Playwright expects a
# chromium_headless_shell path for default headless launch; replace the large
# downloaded shell with a tiny symlink shim to the regular Chromium binary.
RUN mkdir -p /ms-playwright && \
    npm install -g agent-browser && \
    npx -y playwright@1.57.0 install --with-deps chromium ffmpeg && \
    rm -rf /ms-playwright/firefox-* /ms-playwright/webkit-* /ms-playwright/chromium_headless_shell-* && \
    chromium_dir="$(find /ms-playwright -maxdepth 1 -type d -name 'chromium-*' -print -quit)" && \
    chromium_build="${chromium_dir##*-}" && \
    mkdir -p "/ms-playwright/chromium_headless_shell-${chromium_build}/chrome-linux" && \
    ln -sf "${chromium_dir}/chrome-linux/chrome" "/ms-playwright/chromium_headless_shell-${chromium_build}/chrome-linux/headless_shell" && \
    ln -sf "$(find /ms-playwright -path '*/ffmpeg-linux' -type f -print -quit)" /usr/local/bin/ffmpeg && \
    chmod -R a+rX /ms-playwright && \
    npm cache clean --force && \
    rm -rf /root/.npm/_cacache /root/.npm/_npx /var/lib/apt/lists/*

# Use tini as PID 1 — reaps zombie processes automatically.
ENTRYPOINT ["/usr/bin/tini", "--"]

# Create workspace/home mount points. /tmp/sero-home must be writable for arbitrary host UID/GID.
RUN mkdir -p /workspace /tmp/sero-home && chmod 1777 /workspace /tmp/sero-home
WORKDIR /workspace
