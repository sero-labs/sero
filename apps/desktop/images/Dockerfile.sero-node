FROM golang:1.26.3-bookworm@sha256:386d475a660466863d9f8c766fec64d7fdad3edac2c6a05020c09534d71edb4b AS gh-builder

ARG GH_VERSION=2.92.0
RUN CGO_ENABLED=0 GOBIN=/out /usr/local/go/bin/go install github.com/cli/cli/v2/cmd/gh@v${GH_VERSION}

FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ARG SERO_NODE_VERSION=dev
ARG NODE_VERSION=26.7.0
ARG NODE_SHA256_ARM64=afc7a004018485092ac8985b817b0d5684472bd9472e0b57d2ab88737e50090d
ARG NODE_SHA256_X64=982aa24dd8be4c889c6a8ab337ddff3b0896645b20f4239356e80552c16277ee
LABEL org.opencontainers.image.title="Sero Node Runtime" \
      org.opencontainers.image.version="$SERO_NODE_VERSION"

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Base runtime and native build tools. GitHub CLI is built in a separate
# stage with a patched Go toolchain, then copied into this image.
RUN apt-get update -qq && \
    apt-get upgrade -y -qq && \
    apt-get install -y -qq --no-install-recommends \
      ca-certificates curl wget xz-utils \
      tini \
      git openssh-client \
      procps less jq \
      iproute2 \
      build-essential \
      python3 python3-venv python3-pip \
      ripgrep fd-find unzip zip sqlite3 && \
    ln -sf /usr/bin/fdfind /usr/local/bin/fd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=gh-builder /out/gh /usr/local/bin/gh

# Install the pinned official Node.js 24 Linux tarball and verify its checksum.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      arm64) node_arch="arm64"; node_sha256="$NODE_SHA256_ARM64" ;; \
      amd64) node_arch="x64"; node_sha256="$NODE_SHA256_X64" ;; \
      *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    node_version="v${NODE_VERSION}"; \
    curl -fsSLO "https://nodejs.org/dist/${node_version}/node-${node_version}-linux-${node_arch}.tar.xz"; \
    echo "${node_sha256}  node-${node_version}-linux-${node_arch}.tar.xz" | sha256sum -c -; \
    tar -xJf "node-${node_version}-linux-${node_arch}.tar.xz" -C /usr/local --strip-components=1 --no-same-owner; \
    rm "node-${node_version}-linux-${node_arch}.tar.xz"; \
    node --version; \
    npm --version

# Install npm runtime tools from a lockfile with exact package integrities.
COPY apps/desktop/runtime-tools/package.json apps/desktop/runtime-tools/package-lock.json /tmp/runtime-tools/
RUN cd /tmp/runtime-tools && npm ci --ignore-scripts --omit=dev --workspaces=false && \
    mv /tmp/runtime-tools /opt/sero-runtime && \
    ln -sf /opt/sero-runtime/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf /opt/sero-runtime/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    ln -sf /opt/sero-runtime/node_modules/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm

# Configure Git defaults for non-interactive agent use.
RUN git config --global user.name "Sero" && \
    git config --global user.email "sero@local" && \
    git config --global init.defaultBranch main

# agent-browser + Chromium/ffmpeg browser assets. Playwright expects a
# chromium_headless_shell path for default headless launch; replace the large
# downloaded shell with a tiny symlink shim to the regular Chromium binary.
RUN mkdir -p /ms-playwright && \
    ln -sf /opt/sero-runtime/node_modules/agent-browser/bin/agent-browser.js /usr/local/bin/agent-browser && \
    node /opt/sero-runtime/node_modules/playwright/cli.js install --with-deps chromium ffmpeg && \
    rm -rf /ms-playwright/firefox-* /ms-playwright/webkit-* /ms-playwright/chromium_headless_shell-* && \
    chromium_dir="$(find /ms-playwright -maxdepth 1 -type d -name 'chromium-*' -print -quit)" && \
    chromium_build="${chromium_dir##*-}" && \
    mkdir -p "/ms-playwright/chromium_headless_shell-${chromium_build}/chrome-linux" && \
    ln -sf "${chromium_dir}/chrome-linux/chrome" "/ms-playwright/chromium_headless_shell-${chromium_build}/chrome-linux/headless_shell" && \
    ln -sf "$(find /ms-playwright -path '*/ffmpeg-linux' -type f -print -quit)" /usr/local/bin/ffmpeg && \
    chmod -R a+rX /ms-playwright && \
    npm cache clean --force && \
    rm -rf /root/.npm/_cacache /root/.npm/_npx /var/lib/apt/lists/*

# Use tini as PID 1 — reaps zombie processes automatically.
ENTRYPOINT ["/usr/bin/tini", "--"]

# Create workspace/home mount points. /tmp/sero-home must be writable for arbitrary host UID/GID.
RUN mkdir -p /workspace /tmp/sero-home && chmod 1777 /workspace /tmp/sero-home
WORKDIR /workspace
