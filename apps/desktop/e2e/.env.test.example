# Copy this file to .env.test and fill in real values to run the agent suite.
# .env.test is gitignored.

# Provider for agent-realism tests. "anthropic" (default), "openai", "google", ...
SERO_E2E_LLM_PROVIDER=openai

# Provider API key. Shell/CI env vars override this file; only the selected
# provider key is forwarded to Electron.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# LLM tier:
#   off    — skip @agent tests (default)
#   cheap  — Haiku-tier, < $0.10/run, used by nightly CI
#   full   — Sonnet/Opus, < $2/run, manual only
SERO_E2E_LLM_MODE=off

# Optional primary model override. Defaults by provider/mode:
#   anthropic cheap=claude-haiku-4-5, full=claude-sonnet-4-6
#   openai cheap=gpt-5.4-mini, full=gpt-5.5
#   google cheap=gemini-3-flash-preview, full=gemini-3-pro-preview
# SERO_E2E_LLM_MODEL=

# Optional explicit alternate model for model-switch coverage. The test never
# auto-selects an alternate model, to avoid accidentally choosing an expensive one.
# SERO_E2E_LLM_ALT_MODEL=
