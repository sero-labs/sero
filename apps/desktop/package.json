{
  "name": "@sero/desktop",
  "version": "0.3.0-beta.0",
  "description": "Zero context switch, zero sprawl - an agent-first workspace",
  "homepage": "https://sero.ai",
  "author": {
    "name": "Sero Labs",
    "email": "hello@sero.ai"
  },
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && NODE_ENV=development electron .",
    "dev:raw": "concurrently --kill-others \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:electron && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && npx playwright test",
    "e2e:contract": "npm run build && npx playwright test --project=contract",
    "e2e:workflow": "npm run build && npx playwright test --project=workflow",
    "e2e:agent": "npm run build && npx playwright test --project=agent --pass-with-no-tests",
    "e2e:headed": "npm run build && npx playwright test --project=workflow --headed",
    "e2e:doctor": "bash scripts/e2e-doctor.sh",
    "container:nat": "sudo ./scripts/setup-container-nat.sh",
    "container:nat:teardown": "sudo ./scripts/setup-container-nat.sh --teardown",
    "container:build-image": "cd images && container build -t ghcr.io/sero-labs/sero-node:latest -f Dockerfile.sero-node .",
    "browser-pack:build": "node scripts/browser-pack/build-browser-pack.mjs",
    "browser-pack:smoke": "node scripts/browser-pack/smoke-browser-pack.mjs",
    "browser-pack:merge-metadata": "node scripts/browser-pack/merge-browser-pack-metadata.mjs",
    "browser-pack:verify-published": "node scripts/browser-pack/verify-browser-pack-publication.mjs",
    "verify:host-mode-release": "node scripts/verify-host-mode-release.mjs",
    "release": "bash scripts/build-release.sh --target current",
    "release:signed": "bash scripts/build-release.sh --target current --sign",
    "pack": "bash scripts/build-release.sh --target current --dir",
    "pack:mac": "bash scripts/build-release.sh --target mac --dir",
    "pack:linux": "bash scripts/build-release.sh --target linux --dir",
    "pack:win": "bash scripts/build-release.sh --target win --dir",
    "dist": "bash scripts/build-release.sh --target current",
    "dist:mac": "bash scripts/build-release.sh --target mac",
    "dist:linux": "bash scripts/build-release.sh --target linux",
    "dist:linux:x64": "bash scripts/build-release.sh --target linux --arch x64",
    "dist:linux:arm64": "bash scripts/build-release.sh --target linux --arch arm64",
    "dist:win": "bash scripts/build-release.sh --target win",
    "toolchain:verify-published": "node scripts/toolchains/verify-toolchain-publication.mjs",
    "toolchain:merge-metadata": "node scripts/toolchains/merge-toolchain-metadata.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@sero-ai/common": "workspace:*",
    "ansi-styles": "4.3.0",
    "chalk": "4.1.2",
    "cli-highlight": "2.1.11",
    "diff": "^8.0.3",
    "discord.js": "^14.26.4",
    "electron-updater": "^6.8.3",
    "esbuild": "^0.27.4",
    "glob": "^11.0.3",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "supports-color": "7.2.0",
    "typebox": "catalog:",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@discordjs/rest": "^2.6.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/rebuild": "^4.0.4",
    "@emotion/is-prop-valid": "^1.4.0",
    "@headless-tree/core": "^1.6.3",
    "@headless-tree/react": "^1.6.3",
    "@module-federation/enhanced": "2.2.2",
    "@module-federation/vite": "catalog:",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.59.1",
    "@remixicon/react": "^4.9.0",
    "@sero-ai/app-runtime": "workspace:@sero-ai/app-runtime@*",
    "@sero-ai/ui": "workspace:*",
    "@streamdown/code": "^1.1.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "catalog:",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.1",
    "electron": "41.6.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^26.1.0",
    "lucide-react": "catalog:",
    "monaco-editor": "^0.52.2",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-grid-layout": "^2.2.3",
    "react-resizable-panels": "^4.7.2",
    "streamdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zustand": "^5.0.11"
  },
  "build": {
    "extends": null
  }
}
