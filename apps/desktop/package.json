{
  "name": "@sero/desktop",
  "version": "0.1.0",
  "description": "Zero context switch, zero sprawl - an agent-first workspace for macOS",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && NODE_ENV=development electron .",
    "dev:raw": "concurrently --kill-others \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:electron && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && npx playwright test",
    "e2e:contract": "npm run build && npx playwright test --project=contract",
    "e2e:workflow": "npm run build && npx playwright test --project=workflow",
    "e2e:agent": "npm run build && npx playwright test --project=agent --pass-with-no-tests",
    "e2e:headed": "npm run build && npx playwright test --project=workflow --headed",
    "e2e:doctor": "bash scripts/e2e-doctor.sh",
    "container:nat": "sudo ./scripts/setup-container-nat.sh",
    "container:nat:teardown": "sudo ./scripts/setup-container-nat.sh --teardown",
    "container:build-image": "cd images && container build -t ghcr.io/sero-labs/sero-node:latest -f Dockerfile.sero-node .",
    "browser-pack:build": "node scripts/browser-pack/build-browser-pack.mjs",
    "browser-pack:smoke": "node scripts/browser-pack/smoke-browser-pack.mjs",
    "release": "bash scripts/build-release.sh",
    "release:signed": "bash scripts/build-release.sh --sign",
    "pack": "bash -c 'trap \"node scripts/cleanup-packaging.mjs\" EXIT; node scripts/prepare-packaging.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false npx electron-builder --config electron-builder.yml --mac --dir'",
    "dist": "bash -c 'trap \"node scripts/cleanup-packaging.mjs\" EXIT; node scripts/prepare-packaging.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false npx electron-builder --config electron-builder.yml --mac'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.45.0",
    "@headless-tree/core": "^1.6.3",
    "@headless-tree/react": "^1.6.3",
    "@mariozechner/pi-agent-core": "catalog:",
    "@mariozechner/pi-ai": "catalog:",
    "@mariozechner/pi-coding-agent": "catalog:",
    "@module-federation/enhanced": "^2.2.0",
    "@module-federation/vite": "catalog:",
    "@monaco-editor/react": "^4.7.0",
    "@remixicon/react": "^4.9.0",
    "@sero-ai/common": "workspace:*",
    "@streamdown/code": "^1.1.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "catalog:",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.3",
    "discord.js": "^14.25.1",
    "esbuild": "^0.27.4",
    "glob": "^11.0.3",
    "lucide-react": "catalog:",
    "monaco-editor": "^0.52.2",
    "motion": "catalog:",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-grid-layout": "^2.2.3",
    "react-resizable-panels": "^4.7.2",
    "streamdown": "catalog:",
    "typebox": "catalog:",
    "ws": "^8.20.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@discordjs/rest": "^2.6.1",
    "@electron/rebuild": "^4.0.4",
    "@emotion/is-prop-valid": "^1.4.0",
    "@playwright/test": "^1.59.1",
    "@sero-ai/app-runtime": "workspace:@sero-ai/app-runtime@*",
    "@sero-ai/ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^9.2.1",
    "electron": "41.6.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "extends": null
  }
}
