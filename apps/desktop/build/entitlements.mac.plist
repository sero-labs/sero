<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Allow JIT for V8 (Electron renderer) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Allow unsigned executable memory (required by Electron/V8) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow loading third-party plugins (node-pty, better-sqlite3) -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Network access (agent API calls, gateway server, etc.) -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- File access — This entitlement only applies inside an App Sandbox.
       Sero currently runs with hardened runtime but WITHOUT App Sandbox,
       so this has no effect. Kept as a placeholder for future sandboxing. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
