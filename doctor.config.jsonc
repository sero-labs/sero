// React Doctor — https://www.react.doctor/ci
//
// Everything stays on by default. The one exception below is scoped as
// narrowly as it can be, so the rule keeps working where it was written to
// work: React components in `ui/` and `src/`.
{
  "ignore": {
    "overrides": [
      {
        // Node-side code: plugin runtimes and extensions, the Electron main
        // process, and build/dev scripts. None of it renders anything.
        // Matched against paths relative to whichever project is being
        // scanned, so each directory is listed both ways: as a workspace scan
        // sees it and as a repo-root scan does. Anchored at the top of a
        // package on purpose — `**/runtime/**` would also catch
        // `src/components/runtime/`, which is React and should keep the rule.
        "files": [
          "runtime/**",
          "extension/**",
          "electron/**",
          "scripts/**",
          "plugins/*/runtime/**",
          "plugins/*/extension/**",
          "apps/*/electron/**",
          "apps/*/scripts/**",
          "packages/*/scripts/**"
        ],
        // Sequential `await` is the point in this code, not an oversight.
        // These files write records to disk one at a time on purpose:
        //
        //  - Order is the durability rule. A job's terminal state is written
        //    before the target that points at it, and the files of a revision
        //    before the record naming them, so that a crash between two writes
        //    leaves a state that startup recovery can repair. `Promise.all`
        //    would run them in whatever order they finish, and the recovery
        //    code would have nothing left to reason about.
        //  - Many of the loops write the *same* record. Each write takes that
        //    record's lock, so running them together only queues them up again,
        //    with contention and retries in place of a plain loop.
        //  - The startup sweeps walk every record in the library. Fanning those
        //    out means hundreds of concurrent file handles at launch to save
        //    milliseconds nobody is waiting on.
        //
        // Where a loop genuinely has independent work and the concurrency is
        // worth having, it is written with `Promise.all` already (see
        // `reindex` in the design library's store).
        //
        // The other two rules here flag the same pattern outside a loop: two
        // awaits that look independent but are not. A Room writes a member's
        // checkpoint before it compacts that member's context, because the
        // transcript the checkpoint describes is gone afterwards; recovery
        // wakes the Conductor before the members it coordinates. Running
        // either pair together loses the order that makes it correct.
        "rules": [
          "react-doctor/async-await-in-loop",
          "react-doctor/server-sequential-independent-await",
          "react-doctor/async-defer-await"
        ]
      },
      {
        // Same Node-side code, different reason. These four rules trade a
        // readable pass over a collection for a faster one: build a Set or a
        // Map instead of `includes`/`find`, fold `.filter().map()` into one
        // `.reduce()`. That is worth it in a render path, which is what they
        // were written for. It is not worth it here, where the collections are
        // a Room's roster, one member's tool allowlist, or the content blocks
        // of a single message — tens of items at most, read while the process
        // is waiting on a disk write. The rewrite costs readability and buys
        // nothing measurable, so the plain form stays.
        "files": [
          "runtime/**",
          "extension/**",
          "electron/**",
          "scripts/**",
          "plugins/*/runtime/**",
          "plugins/*/extension/**",
          "apps/*/electron/**",
          "apps/*/scripts/**",
          "packages/*/scripts/**"
        ],
        "rules": [
          "react-doctor/js-combine-iterations",
          "react-doctor/js-set-map-lookups",
          "react-doctor/js-index-maps",
          "react-doctor/js-flatmap-filter"
        ]
      },
      {
        // Room blueprints, rosters, tool lists, and timeline filters are small,
        // bounded collections. The canonical rule guidance requires profile
        // evidence before replacing their readable array operations. Keep the
        // rules active elsewhere, where a large or hot collection can justify
        // the extra Set or loop machinery.
        "files": [
          "shared/room-access-map.ts",
          "shared/room-clamp.ts",
          "shared/room-diff.ts",
          "shared/room-locks.ts",
          "shared/room-member-ref.ts",
          "shared/room-validation.ts",
          "ui/components/RoomActivity.tsx",
          "ui/components/RoomAdvancedSettings.tsx",
          "ui/components/RoomMessageDialog.tsx",
          "ui/lib/proposal-diff.ts",
          "plugins/sero-orchestrator-plugin/shared/room-access-map.ts",
          "plugins/sero-orchestrator-plugin/shared/room-clamp.ts",
          "plugins/sero-orchestrator-plugin/shared/room-diff.ts",
          "plugins/sero-orchestrator-plugin/shared/room-locks.ts",
          "plugins/sero-orchestrator-plugin/shared/room-member-ref.ts",
          "plugins/sero-orchestrator-plugin/shared/room-validation.ts",
          "plugins/sero-orchestrator-plugin/ui/components/RoomActivity.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomAdvancedSettings.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomMessageDialog.tsx",
          "plugins/sero-orchestrator-plugin/ui/lib/proposal-diff.ts"
        ],
        "rules": [
          "react-doctor/js-combine-iterations",
          "react-doctor/js-set-map-lookups",
          "react-doctor/js-tosorted-immutable"
        ]
      },
      {
        // `room-kit` is the public component surface for this Vite plugin.
        // Vite tree-shakes its pure local re-exports, so direct imports add
        // coupling without reducing the shipped bundle.
        "files": [
          "ui/components/AttentionLoopCards.tsx",
          "ui/components/AttentionQueue.tsx",
          "ui/components/HomeView.tsx",
          "ui/components/ListRow.tsx",
          "ui/components/LoopsOverview.tsx",
          "ui/components/RoomActivity.tsx",
          "ui/components/RoomAdvancedSettings.tsx",
          "ui/components/RoomApprovalCard.tsx",
          "ui/components/RoomAttentionCards.tsx",
          "ui/components/RoomBriefForm.tsx",
          "ui/components/RoomDetail.tsx",
          "ui/components/RoomMemberFacts.tsx",
          "ui/components/RoomMemberPanel.tsx",
          "ui/components/RoomMemberTranscript.tsx",
          "ui/components/RoomPlanning.tsx",
          "ui/components/RoomProposal.tsx",
          "ui/components/RoomRoster.tsx",
          "ui/components/RoomSidePanel.tsx",
          "ui/components/RoomTopBar.tsx",
          "ui/components/RoomWatch.tsx",
          "ui/components/RoomsOverview.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/AttentionLoopCards.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/AttentionQueue.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/HomeView.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/ListRow.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/LoopsOverview.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomActivity.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomAdvancedSettings.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomApprovalCard.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomAttentionCards.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomBriefForm.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomDetail.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomMemberFacts.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomMemberPanel.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomMemberTranscript.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomPlanning.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomProposal.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomRoster.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomSidePanel.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomTopBar.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomWatch.tsx",
          "plugins/sero-orchestrator-plugin/ui/components/RoomsOverview.tsx"
        ],
        "rules": [
          "react-doctor/no-barrel-import"
        ]
      },
      {
        // This hook synchronizes external shell navigation with the plugin's
        // durable state. The effects do not send child-owned render data to a
        // parent; they react to host history and launch events.
        "files": [
          "ui/lib/orchestrator-navigation.ts",
          "plugins/sero-orchestrator-plugin/ui/lib/orchestrator-navigation.ts"
        ],
        "rules": [
          "react-doctor/no-pass-data-to-parent"
        ]
      }
    ]
  }
}
