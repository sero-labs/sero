{
  "name": "@sero/git",
  "version": "0.1.0",
  "description": "Git workspace manager for Sero - visual commit graph, branching, staging, and diffs",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p extension/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "sero": {
    "app": {
      "id": "git",
      "name": "Git",
      "icon": "git-branch",
      "stateFile": ".sero/apps/git/state.json",
      "ui": "./dist/ui/remoteEntry.js",
      "component": "GitApp",
      "devPort": 5194
    }
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "catalog:peer",
    "@mariozechner/pi-coding-agent": "catalog:peer",
    "@mariozechner/pi-tui": "catalog:peer"
  },
  "devDependencies": {
    "@module-federation/vite": "catalog:",
    "@sero-ai/app-runtime": "workspace:@sero-ai/app-runtime@*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
