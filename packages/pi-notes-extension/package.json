{
  "name": "@sero/notes",
  "version": "0.1.0",
  "description": "Note-taking app for Sero \u2014 Pi extension with web UI",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "sero": {
    "app": {
      "id": "notes",
      "name": "Notes",
      "icon": "notebook-pen",
      "scope": "global",
      "stateFile": ".sero/apps/notes/state.json",
      "ui": "./dist/ui/remoteEntry.js",
      "component": "NotesApp",
      "devPort": 5178
    }
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "catalog:peer",
    "@mariozechner/pi-coding-agent": "catalog:peer",
    "@mariozechner/pi-tui": "catalog:peer",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@module-federation/vite": "catalog:",
    "@sero-ai/app-runtime": "workspace:@sero-ai/app-runtime@*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
