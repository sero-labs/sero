{
  "name": "@sero/kanban",
  "version": "0.1.0",
  "description": "Kanban dev board for Sero \u2014 AI-driven development workflow",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p extension/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "prompts": [
      "./prompts/brainstorm.md",
      "./prompts/card-enhance.md"
    ]
  },
  "sero": {
    "app": {
      "id": "kanban",
      "name": "Kanban",
      "icon": "columns-3",
      "stateFile": ".sero/apps/kanban/state.json",
      "ui": "./dist/ui/remoteEntry.js",
      "component": "KanbanApp",
      "devPort": 5189
    }
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "catalog:peer",
    "@mariozechner/pi-coding-agent": "catalog:peer",
    "@mariozechner/pi-tui": "catalog:peer",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@module-federation/vite": "catalog:",
    "@sero/app-runtime": "workspace:@sero-ai/app-runtime@*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
