{
  "name": "@sero/calc",
  "version": "0.1.0",
  "description": "Modern calculator app for Sero — Pi extension with web UI",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "sero": {
    "app": {
      "id": "calc",
      "name": "Calculator",
      "icon": "calculator",
      "scope": "global",
      "stateFile": ".sero/apps/calc/state.json",
      "ui": "./dist/ui/remoteEntry.js",
      "component": "CalcApp",
      "devPort": 5175
    }
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "catalog:peer",
    "@mariozechner/pi-coding-agent": "catalog:peer",
    "@mariozechner/pi-tui": "catalog:peer",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@module-federation/vite": "catalog:",
    "@sero/app-runtime": "workspace:*",
    "@sero/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
