{
  "name": "@sero-ai/ink-and-bones",
  "version": "0.2.0",
  "description": "Procedural puppet animation engine: skeletons, painted parts, motion curves, and a pixel-art grade. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.example.json --noEmit",
    "test": "vitest run",
    "build:api": "node scripts/build-api-reference.mjs",
    "build:docs": "node --experimental-strip-types scripts/build-authoring-md.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
