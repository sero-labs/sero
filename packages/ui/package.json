{
  "name": "@sero-ai/ui",
  "version": "0.5.0",
  "description": "Shared UI components, AI elements, and design tokens for the Sero platform",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ai-elements/*": "./src/components/ai-elements/*.tsx",
    "./model-selection/*": "./src/components/model-selection/*.tsx",
    "./dashboard-catalog.json": "./src/components/dashboard/catalog.json",
    "./reference": "./src/reference.ts",
    "./theme": "./src/theme/index.ts",
    "./theme/*": "./src/theme/*",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.reference.config.ts && node scripts/smoke-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-dist.mjs",
    "prepublishOnly": "node scripts/ensure-pnpm-publish.mjs && pnpm build"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./ai-elements/*": {
        "types": "./dist/components/ai-elements/*.d.ts",
        "import": "./dist/components/ai-elements/*.js",
        "require": "./dist/components/ai-elements/*.cjs"
      },
      "./model-selection/*": {
        "types": "./dist/components/model-selection/*.d.ts",
        "import": "./dist/components/model-selection/*.js",
        "require": "./dist/components/model-selection/*.cjs"
      },
      "./dashboard-catalog.json": "./dist/components/dashboard/catalog.json",
      "./reference": {
        "types": "./dist/reference.d.ts",
        "import": "./dist/reference.js",
        "require": "./dist/reference.cjs"
      },
      "./theme": {
        "types": "./dist/theme/index.d.ts",
        "import": "./dist/theme/index.js",
        "require": "./dist/theme/index.cjs"
      },
      "./theme/*": {
        "types": "./dist/theme/*.d.ts",
        "import": "./dist/theme/*.js",
        "require": "./dist/theme/*.cjs"
      },
      "./styles/*": "./dist/styles/*",
      "./package.json": "./package.json",
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js",
        "require": "./dist/*.cjs"
      }
    }
  },
  "peerDependencies": {
    "react": "catalog:peer",
    "react-dom": "catalog:peer"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@radix-ui/react-use-controllable-state": "^1.2.5",
    "@remixicon/react": "^4.9.0",
    "@rive-app/react-webgl2": "^4.31.0",
    "@sero-ai/common": "workspace:*",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.1.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xyflow/react": "^12.11.3",
    "ai": "^6.0.256",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "catalog:",
    "media-chrome": "^4.19.2",
    "motion": "catalog:",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.5",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.85.0",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.12.2",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "3.10.1",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "streamdown": "catalog:",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-syntax-highlighter": "^15.5.13",
    "jsdom": "^26.1.0",
    "react": "catalog:peer",
    "react-dom": "catalog:peer",
    "shadcn": "^3.8.5",
    "tailwindcss": "catalog:",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
